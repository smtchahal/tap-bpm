{
  "name": "tap-bpm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm dlx wrangler pages deploy dist",
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "ci:lint": "biome ci .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,html,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.7"
  }
}
